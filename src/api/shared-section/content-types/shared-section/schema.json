    },
    "process": {
      "type": "component",
      "repeatable": false,
      "component": "shared.process-block"
    },
    "benefits": {
      "type": "component",
      "repeatable": false,
      "component": "shared.benefits-block"
    },
    "testimonials": {
      "type": "component",
      "repeatable": false,
      "component": "home.testimonials"
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "home.cta"
    },
    "financeBanner": {
      "type": "component",
      "repeatable": false,
      "component": "shared.finance-banner"
    }
  }
}

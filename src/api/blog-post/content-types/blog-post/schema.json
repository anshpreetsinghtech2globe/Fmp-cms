{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post",
    "description": "Full blog articles — title, excerpt, featured image, content blocks, author, and SEO."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["Guides", "Trends", "Tips", "Comparisons"],
      "required": true,
      "default": "Guides"
    },
    "publishedOn": {
      "type": "date",
      "required": true
    },
    "featuredImage": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "legacyImageUrl": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "blogPosts"
    },
    "blocks": {
      "type": "component",
      "repeatable": true,
      "component": "blog.block"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    }
  }
}
